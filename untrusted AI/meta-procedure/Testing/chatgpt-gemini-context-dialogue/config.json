{
  "api": {
    "key_env": "GEMINI_API_KEY",
    "model": "gemini-3.8-flash",
    "default_model": "gemini-3.8-flash",
    "endpoint": "https://generativelanguage.googleapis.com/v1beta",
    "timeout_ms": 600000,
    "max_retries": 2,
    "retry_delay_ms": 1000
  },
  "generation": {
    "temperature": 0,
    "top_p": 0.95,
    "top_k": 40,
    "response_mime_type": "application/json",
    "max_output_tokens": 65536
  },
  "paths": {
    "runtime_root": "../../../../",
    "runs_root": "untrusted AI/meta-procedure/Testing/chatgpt-gemini-context-dialogue/runs",
    "trigger_file": "untrusted AI/meta-procedure/Testing/chatgpt-gemini-context-dialogue/trigger.json",
    "messages_file": "messages.json",
    "output_file": "output.json",
    "latest_output_file": "untrusted AI/meta-procedure/Testing/chatgpt-gemini-context-dialogue/latest-output.json",
    "write_latest_outputs": true
  },
  "run": {
    "nonce_param": "run_nonce",
    "nonce_regex": "^[A-Za-z0-9._-]+$",
    "default_nonce_prefix": "agents_revision_pass2",
    "default_nonce": "agents_revision_pass2_20261013_1",
    "reuse_history": false
  },
  "prompt": {
    "system_instruction": "You are the independent author executing PASS TWO of the AGENTS revision. Read the complete first-pass schema and all five original inputs. Generate the entire revised procedure and accompanying deliverables conforming to the first-pass schema. Return one complete valid JSON object. Do not generate another schema instead of the document. Do not claim external tool execution or verification unavailable to you.",
    "heuristic": "Follow every handoff requirement. Use the generated second_pass_return_schema as the output contract. Its generic object allowance for revised procedure sections is not permission to omit the requested template: every instruction/question set must include long-form plain-language instructions, local inputs with definitions, actual capture questions and returns, and consistently structured useful few-shot examples. Keep pre-execution, actual execution/recovery, and post-execution distinct and ordered. Track every file edit and its purpose tied to desired state; specify and demonstrate actual value-based verification and tables. Consolidate duplicated concepts, keep basis defined once, fixed as These aspects remain unchanged, and no invented routing metadata. Request-and-return constitutes variable use. Preserve complete instructions and exceed or meet the original reference verbosity without repetitive padding. For evidence you cannot inspect, record UNVERIFIED and the limitation rather than fabricate observed values.",
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SecondPassAgentsRevisionDeliverable",
      "description": "Authoritative, complete machine-readable contract governing the second-pass AGENTS procedure revision and execution deliverable.",
      "type": "object",
      "required": [
        "response_type",
        "revised_agents_procedure",
        "state_transition_accounting_and_verification",
        "semantic_concept_inventory",
        "captured_variable_lifecycle_matrix",
        "coverage_and_validation_report",
        "status"
      ],
      "properties": {
        "response_type": {
          "type": "string",
          "const": "revised_agents_procedure_deliverable"
        },
        "revised_agents_procedure": {
          "type": "array",
          "description": "Complete, untruncated natural-language executable procedure array meeting or exceeding the original AGENTS document character and line floors.",
          "minItems": 8,
          "items": {
            "type": "object",
            "description": "Constituent procedure section: metadata, authority declaration, semantics, pre-execution phases, execution core, post-execution phases, continuation selector, status selector, profile specifications, or universal suffix."
          }
        },
        "state_transition_accounting_and_verification": {
          "type": "object",
          "description": "Mandatory state-transition accounting and value verification covering every persistent file edit, initial/desired/final values, basis citations, and verified evidence.",
          "required": [
            "transitions_table",
            "value_verification_records",
            "fixed_aspects_preservation_records",
            "discrepancy_and_unverified_records"
          ],
          "properties": {
            "transitions_table": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "edit_sequence",
                  "target_file_or_entity",
                  "aspect",
                  "edit_purpose",
                  "initial_value",
                  "desired_value",
                  "observed_final_value",
                  "initial_basis",
                  "final_basis",
                  "verification_operation",
                  "observed_evidence",
                  "comparison_outcome"
                ],
                "properties": {
                  "edit_sequence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "target_file_or_entity": {
                    "type": "string"
                  },
                  "aspect": {
                    "type": "string"
                  },
                  "edit_purpose": {
                    "type": "string"
                  },
                  "initial_value": {},
                  "desired_value": {},
                  "observed_final_value": {},
                  "initial_basis": {
                    "type": "object",
                    "required": [
                      "locatorType",
                      "locator"
                    ],
                    "properties": {
                      "locatorType": {
                        "type": "string"
                      },
                      "locator": {
                        "type": "string"
                      }
                    }
                  },
                  "final_basis": {
                    "type": "object",
                    "required": [
                      "locatorType",
                      "locator"
                    ],
                    "properties": {
                      "locatorType": {
                        "type": "string"
                      },
                      "locator": {
                        "type": "string"
                      }
                    }
                  },
                  "verification_operation": {
                    "type": "string"
                  },
                  "observed_evidence": {
                    "type": "string"
                  },
                  "comparison_outcome": {
                    "type": "string",
                    "enum": [
                      "MATCH",
                      "DISCREPANCY",
                      "UNVERIFIED"
                    ]
                  }
                }
              }
            },
            "value_verification_records": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "assertion_id",
                  "target",
                  "asserted_value",
                  "verification_method",
                  "inspected_raw_value",
                  "evaluation",
                  "blocker_or_missing_evidence"
                ],
                "properties": {
                  "assertion_id": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  },
                  "asserted_value": {},
                  "verification_method": {
                    "type": "string"
                  },
                  "inspected_raw_value": {},
                  "evaluation": {
                    "type": "string",
                    "enum": [
                      "VERIFIED",
                      "FAILED",
                      "UNVERIFIED"
                    ]
                  },
                  "blocker_or_missing_evidence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "fixed_aspects_preservation_records": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "aspect",
                  "established_initial_value",
                  "observed_final_value",
                  "preservation_verified",
                  "basis_inspected"
                ],
                "properties": {
                  "aspect": {
                    "type": "string"
                  },
                  "established_initial_value": {},
                  "observed_final_value": {},
                  "preservation_verified": {
                    "type": "boolean"
                  },
                  "basis_inspected": {
                    "type": "object",
                    "required": [
                      "locatorType",
                      "locator"
                    ],
                    "properties": {
                      "locatorType": {
                        "type": "string"
                      },
                      "locator": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "discrepancy_and_unverified_records": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "target",
                  "aspect",
                  "discrepancy_type",
                  "details",
                  "impact_on_final_status"
                ],
                "properties": {
                  "target": {
                    "type": "string"
                  },
                  "aspect": {
                    "type": "string"
                  },
                  "discrepancy_type": {
                    "type": "string",
                    "enum": [
                      "MISMATCH",
                      "UNVERIFIED_EVIDENCE",
                      "UNMET_PREREQUISITE"
                    ]
                  },
                  "details": {
                    "type": "string"
                  },
                  "impact_on_final_status": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "semantic_concept_inventory": {
          "type": "array",
          "description": "Comprehensive audit of all 24+ core operative concepts, ensuring authoritative single-location ownership and zero redundant synonyms.",
          "items": {
            "type": "object",
            "required": [
              "concept_name",
              "owning_section",
              "plain_language_definition",
              "synonyms_deprecated_or_prohibited",
              "referencing_sections"
            ],
            "properties": {
              "concept_name": {
                "type": "string"
              },
              "owning_section": {
                "type": "string"
              },
              "plain_language_definition": {
                "type": "string"
              },
              "synonyms_deprecated_or_prohibited": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "referencing_sections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "captured_variable_lifecycle_matrix": {
          "type": "array",
          "description": "Audit of all captured typed variables verifying the local definition, capture question, return, and consumers.",
          "items": {
            "type": "object",
            "required": [
              "variable_identifier",
              "type",
              "owning_instruction_section",
              "local_definition_present",
              "capture_question_verbatim",
              "capture_return_binding",
              "downstream_consumers_or_closure_element"
            ],
            "properties": {
              "variable_identifier": {
                "type": "string"
              },
              "type": {
                "type": [
                  "string",
                  "array"
                ]
              },
              "owning_instruction_section": {
                "type": "string"
              },
              "local_definition_present": {
                "type": "boolean"
              },
              "capture_question_verbatim": {
                "type": "string"
              },
              "capture_return_binding": {},
              "downstream_consumers_or_closure_element": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "coverage_and_validation_report": {
          "type": "object",
          "description": "Substantive evaluation of prompt instructions, character/line verbosity metrics, and architectural integrity.",
          "required": [
            "verbosity_metrics",
            "substantive_obligations_audit",
            "schema_notation_resolution",
            "continuation_and_status_alignment",
            "untruncated_closure_verified"
          ],
          "properties": {
            "verbosity_metrics": {
              "type": "object",
              "required": [
                "original_line_count_floor",
                "original_char_count_floor",
                "revised_line_count",
                "revised_char_count",
                "floor_satisfied"
              ],
              "properties": {
                "original_line_count_floor": {
                  "type": "integer",
                  "const": 2024
                },
                "original_char_count_floor": {
                  "type": "integer",
                  "const": 99817
                },
                "revised_line_count": {
                  "type": "integer"
                },
                "revised_char_count": {
                  "type": "integer"
                },
                "floor_satisfied": {
                  "type": "boolean"
                }
              }
            },
            "substantive_obligations_audit": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "obligation_title",
                  "status",
                  "verification_evidence"
                ],
                "properties": {
                  "obligation_title": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "MET",
                      "UNMET",
                      "PARTIALLY_MET"
                    ]
                  },
                  "verification_evidence": {
                    "type": "string"
                  }
                }
              }
            },
            "schema_notation_resolution": {
              "type": "object",
              "required": [
                "custom_keys_rule_documented",
                "standard_json_schema_properties_reconciliation"
              ],
              "properties": {
                "custom_keys_rule_documented": {
                  "type": "string"
                },
                "standard_json_schema_properties_reconciliation": {
                  "type": "string"
                }
              }
            },
            "continuation_and_status_alignment": {
              "type": "object",
              "required": [
                "continuation_scenarios_count",
                "few_shot_examples_present",
                "status_selector_criteria_aligned"
              ],
              "properties": {
                "continuation_scenarios_count": {
                  "type": "integer",
                  "minimum": 34
                },
                "few_shot_examples_present": {
                  "type": "boolean"
                },
                "status_selector_criteria_aligned": {
                  "type": "boolean"
                }
              }
            },
            "untruncated_closure_verified": {
              "type": "boolean"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "BLOCKED",
            "FAILED"
          ]
        }
      }
    },
    "template_prefix": "SECOND PASS: generate the full revised AGENTS procedure under the first-pass schema.",
    "template_suffix": "Return response_type=revised_agents_procedure_deliverable. Include the entire revised_agents_procedure and all required schema fields. No truncation, ellipses, missing examples, shortened outlines or placeholders. The uniform section template is mandatory even though the schema's generic section objects do not enforce its nested shape. Treat illustrative example evidence as illustrative, not live verification. Apply the schema and handoff together."
  },
  "inputs": [
    {
      "key": "revision_instructions",
      "type": "file",
      "path": "untrusted AI/meta-procedure/Procedures/PromptGemini/AGENTS-revision-instructions.md",
      "required": true,
      "numbered": false
    },
    {
      "key": "working_document",
      "type": "file",
      "path": "untrusted AI/meta-procedure/Procedures/PromptGemini/AGENTS-root-array.json",
      "required": true,
      "numbered": false
    },
    {
      "key": "original_agents_reference",
      "type": "file",
      "path": "untrusted AI/meta-procedure/Procedures/PromptGemini/AGENTS-original-reference.json",
      "required": true,
      "numbered": false
    },
    {
      "key": "prompt_gemini_procedure",
      "type": "file",
      "path": "untrusted AI/meta-procedure/Procedures/PromptGemini/PromptGemini.json",
      "required": true,
      "numbered": false
    },
    {
      "key": "execution_workflow",
      "type": "file",
      "path": ".github/workflows/prompt-gemini-context-rich-dialogue.yml",
      "required": true,
      "numbered": false
    },
    {
      "key": "first_pass_schema",
      "type": "file",
      "path": "untrusted AI/meta-procedure/Testing/chatgpt-gemini-context-dialogue/runs/agents_schema_design_20261013_1/output.json",
      "required": true,
      "numbered": false
    }
  ],
  "validation": {
    "expected_response_type": "revised_agents_procedure_deliverable",
    "require_json": true,
    "strip_markdown_fence": true,
    "allow_repair": true
  },
  "execution": {
    "same_turn": true,
    "verbose": true
  }
}

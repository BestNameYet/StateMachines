{
  "version": "1.0",
  "token_counter": {
    "implementation": "heuristic_regex"
  },
  "B_rules": [
    {
      "when": {
        "B": {
          "eq": 0
        }
      },
      "iterator": {
        "divider": {
          "max_tokens": 12000,
          "boundary_strategy": "shift_divisions_until_all_batches_fit"
        },
        "evaluator": {
          "model": "gemini-1.5-flash",
          "task": "Extract an exhaustive inventory of actual features, mechanisms, state transitions, supervisory gates, error handlings, and persistence behaviors backed strictly by current implementation evidence in the assigned context. Every feature record must cite concrete source evidence (file path, symbol/section, exact line or snippet context). Do not infer historical intent or report absent features as defects.",
          "criteria": "1. Evidence-backed: Every capability must cite specific implementation evidence in the assigned context.\n2. Concrete classification: Assign each feature to a recognized category (orchestration, supervisory_gate, state_transition, persistence, external_integration, error_handling, validation).\n3. Strict schema adherence: Return valid JSON matching the Stage-1 extraction response contract.\n4. No hallucinated requirements: Report only what is observed in the context.",
          "response_contract": {
            "required_fields": [
              "inventory_round",
              "features",
              "feature_count"
            ],
            "schema": {
              "type": "object",
              "properties": {
                "inventory_round": {
                  "type": "integer"
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "feature_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string",
                        "enum": [
                          "orchestration",
                          "supervisory_gate",
                          "state_transition",
                          "persistence",
                          "external_integration",
                          "error_handling",
                          "validation",
                          "configuration"
                        ]
                      },
                      "description": {
                        "type": "string"
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "source_path": {
                              "type": "string"
                            },
                            "reference_symbol_or_heading": {
                              "type": "string"
                            },
                            "mechanic_summary": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "source_path",
                            "reference_symbol_or_heading",
                            "mechanic_summary"
                          ]
                        }
                      }
                    },
                    "required": [
                      "feature_id",
                      "name",
                      "category",
                      "description",
                      "evidence"
                    ]
                  }
                },
                "feature_count": {
                  "type": "integer"
                }
              },
              "required": [
                "inventory_round",
                "features",
                "feature_count"
              ]
            }
          }
        },
        "normalization": {
          "enabled": true,
          "strategies": [
            "recover_required_fields_from_malformed_serialization"
          ]
        },
        "acceptance": {
          "conditions": [
            {
              "id": "invocation_succeeded",
              "source": "invocation.status",
              "operator": "eq",
              "value": "success"
            },
            {
              "id": "required_fields_recoverable",
              "source": "response",
              "operator": "required_fields_recoverable",
              "value": true
            },
            {
              "id": "response_below_hard_token_limit",
              "source": "response.tokens",
              "operator": "lt",
              "value": {
                "source": "divider.max_tokens",
                "divide_by": 2
              }
            }
          ]
        },
        "retry": {
          "conditionals": [
            {
              "id": "system_error_retry",
              "when": {
                "condition": "system_error",
                "retry_number": {
                  "eq": 0
                }
              },
              "invoke": {
                "fresh": true,
                "inputs": [
                  "original_invocation"
                ]
              },
              "on_success": {
                "retain": "retry_response",
                "stop_retry_sequence": true
              },
              "on_failure": {
                "status": "failed",
                "retain": null,
                "stop_retry_sequence": true
              }
            },
            {
              "id": "mechanical_response_retry",
              "when": {
                "condition": "mechanical_response_failure",
                "retry_number": {
                  "eq": 0
                }
              },
              "invoke": {
                "fresh": true,
                "inputs": [
                  "context",
                  "previous_response",
                  "mechanical_error",
                  "task",
                  "criteria",
                  "response_contract"
                ]
              },
              "on_success": {
                "retain": "retry_response",
                "stop_retry_sequence": true
              },
              "on_failure": {
                "retain": "latest_response",
                "include_failure_metadata": true,
                "stop_retry_sequence": true
              }
            }
          ]
        },
        "termination": {
          "condition": {
            "left": {
              "source": "round.aggregate_response_tokens"
            },
            "operator": "lte",
            "right": {
              "source": "divider.max_tokens"
            }
          },
          "on_true": {
            "set": {
              "terminal_round": true
            }
          },
          "on_false": {
            "set": {
              "terminal_round": false
            }
          }
        },
        "failed_b_stop": {
          "condition": {
            "source": "supervisory.failed_b_count",
            "operator": "gte",
            "value": 1
          },
          "on_true": "program_failure_return",
          "on_false": "continue"
        }
      }
    },
    {
      "when": {
        "B": {
          "gt": 0
        }
      },
      "iterator": {
        "divider": {
          "max_tokens": 12000,
          "boundary_strategy": "shift_divisions_until_all_batches_fit"
        },
        "evaluator": {
          "model": "gemini-1.5-flash",
          "task": "Deduplicate, normalize, merge, and reconcile the extracted feature inventory records from previous batches. Merge overlapping features under a unified name and comprehensive description while unioning all supporting evidence references and provenance batch IDs. Eliminate exact duplicate entries. Ensure canonical categories are maintained.",
          "criteria": "1. Evidence preservation: Retain all valid source citations and provenance tags from merged entries.\n2. Deduplication: Merge redundant or overlapping feature descriptions into unified records.\n3. Canonical naming: Use clear, descriptive, consistent naming conventions across all consolidated features.\n4. Strict schema compliance: Return valid JSON matching the consolidated feature inventory schema.",
          "response_contract": {
            "required_fields": [
              "inventory_round",
              "features",
              "feature_count",
              "consolidation_summary"
            ],
            "schema": {
              "type": "object",
              "properties": {
                "inventory_round": {
                  "type": "integer"
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "feature_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "source_path": {
                              "type": "string"
                            },
                            "reference_symbol_or_heading": {
                              "type": "string"
                            },
                            "mechanic_summary": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "source_path",
                            "reference_symbol_or_heading",
                            "mechanic_summary"
                          ]
                        }
                      },
                      "source_batches": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "feature_id",
                      "name",
                      "category",
                      "description",
                      "evidence"
                    ]
                  }
                },
                "feature_count": {
                  "type": "integer"
                },
                "consolidation_summary": {
                  "type": "object",
                  "properties": {
                    "input_feature_count": {
                      "type": "integer"
                    },
                    "merged_count": {
                      "type": "integer"
                    },
                    "final_count": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "input_feature_count",
                    "merged_count",
                    "final_count"
                  ]
                }
              },
              "required": [
                "inventory_round",
                "features",
                "feature_count",
                "consolidation_summary"
              ]
            }
          }
        },
        "normalization": {
          "enabled": true,
          "strategies": [
            "recover_required_fields_from_malformed_serialization"
          ]
        },
        "acceptance": {
          "conditions": [
            {
              "id": "invocation_succeeded",
              "source": "invocation.status",
              "operator": "eq",
              "value": "success"
            },
            {
              "id": "required_fields_recoverable",
              "source": "response",
              "operator": "required_fields_recoverable",
              "value": true
            },
            {
              "id": "response_below_hard_token_limit",
              "source": "response.tokens",
              "operator": "lt",
              "value": {
                "source": "divider.max_tokens",
                "divide_by": 2
              }
            }
          ]
        },
        "retry": {
          "conditionals": [
            {
              "id": "system_error_retry",
              "when": {
                "condition": "system_error",
                "retry_number": {
                  "eq": 0
                }
              },
              "invoke": {
                "fresh": true,
                "inputs": [
                  "original_invocation"
                ]
              },
              "on_success": {
                "retain": "retry_response",
                "stop_retry_sequence": true
              },
              "on_failure": {
                "status": "failed",
                "retain": null,
                "stop_retry_sequence": true
              }
            },
            {
              "id": "mechanical_response_retry",
              "when": {
                "condition": "mechanical_response_failure",
                "retry_number": {
                  "eq": 0
                }
              },
              "invoke": {
                "fresh": true,
                "inputs": [
                  "context",
                  "previous_response",
                  "mechanical_error",
                  "task",
                  "criteria",
                  "response_contract"
                ]
              },
              "on_success": {
                "retain": "retry_response",
                "stop_retry_sequence": true
              },
              "on_failure": {
                "retain": "latest_response",
                "include_failure_metadata": true,
                "stop_retry_sequence": true
              }
            }
          ]
        },
        "termination": {
          "condition": {
            "left": {
              "source": "round.aggregate_response_tokens"
            },
            "operator": "lte",
            "right": {
              "source": "divider.max_tokens"
            }
          },
          "on_true": {
            "set": {
              "terminal_round": true
            }
          },
          "on_false": {
            "set": {
              "terminal_round": false
            }
          }
        },
        "failed_b_stop": {
          "condition": {
            "source": "supervisory.failed_b_count",
            "operator": "gte",
            "value": 1
          },
          "on_true": "program_failure_return",
          "on_false": "continue"
        }
      }
    }
  ],
  "supervisory_state": {
    "track": {
      "B": true,
      "b": true,
      "b_terminal_status": true,
      "failed_b_count": true,
      "retries": true,
      "response_tokens": true,
      "provenance": true
    }
  },
  "provenance": {
    "enabled": true,
    "retain_batch_identity": true,
    "retain_ancestry": true
  },
  "program_return": {
    "envelope": {
      "status": {
        "source": "runtime.status"
      },
      "completion_reason": {
        "source": "reason"
      },
      "terminal_round": {
        "source": "runtime.terminalRound"
      },
      "total_rounds": {
        "source": "runtime.B"
      },
      "final_inventory": {
        "source": "aggregate.records"
      },
      "supervisory_summary": {
        "source": "runtime.supervisory"
      }
    }
  }
}

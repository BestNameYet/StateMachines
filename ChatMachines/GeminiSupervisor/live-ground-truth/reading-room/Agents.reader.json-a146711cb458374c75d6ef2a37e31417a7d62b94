{"doc_id":"agents","canonical_path":"ChatMachines/GeminiSupervisor/Agents.md","source_blob_sha":"67ff3ad1e2a28b15e13e39e9e38b8524451e503b","items":[{"type":"content","text":"# Agents.md --- Canonical Rules and Evaluation Contract","eol":"\n"},{"type":"content","text":"","eol":"\n"},{"type":"content","text":"## Canonical Evaluation Definitions","eol":"\n"},{"type":"content","text":"","eol":"\n"},{"type":"content","text":"```json","eol":"\n"},{"type":"content","text":"{","eol":"\n"},{"type":"content","text":"  \"evaluation_definitions\": {","eol":"\n"},{"type":"content","text":"    \"user_words\": {","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"      \"value\": \"The user's current utterance exactly as written, with references resolved only from relevant prior context.\",","eol":"\n"},{"type":"content","text":"      \"definition\": \"User-authored language is primary instruction evidence; agent summaries never replace it.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"Compare preserved request text to the actual user utterance and only the context needed to resolve references.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"The complete user-authored instruction is preserved without controller or agent pollution.\",","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"    },","eol":"\n"},{"type":"content","text":"    \"effective_instruction_U\": {","eol":"\n"},{"type":"content","text":"      \"key\": \"effective_instruction_U\",","eol":"\n"},{"type":"content","text":"      \"value\": \"Resolved user request plus every applicable governing rule.\",","eol":"\n"},{"type":"content","text":"      \"definition\": \"U is the complete set of requirements, prohibitions, permissions, questions, corrections, limits, and procedural constraints for the turn.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"Construct U from user_words and applicable rules while retaining source traceability.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"Every applicable requirement is represented exactly once at the semantic level and retains its source.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"A requirement is omitted, invented, scope-changed, or replaced by agent interpretation.\"","eol":"\n"},{"type":"content","text":"    },","eol":"\n"},{"type":"content","text":"    \"agent_response_P\": {","eol":"\n"},{"type":"content","text":"      \"key\": \"agent_response_P\",","eol":"\n"},{"type":"content","text":"      \"value\": \"The agent's proposed words plus actions and results actually observed.\",","eol":"\n"},{"type":"content","text":"      \"definition\": \"P distinguishes intention, attempt, execution, and verified completion.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"Compare execution-dependent claims to independent live evidence; keep 'will do', 'tried', and 'did' distinct.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"P states only what live evidence supports and accurately identifies incomplete or failed work.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"P reports intention/attempt as completion, asserts unobserved state, masks remaining work, or relies on self-report as evidence.\"","eol":"\n"},{"type":"content","text":"    },","eol":"\n"},{"type":"content","text":"    \"live_ground_truth\": {","eol":"\n"},{"type":"content","text":"      \"key\": \"live_ground_truth\",","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"      \"definition\": \"Ground truth is obtained from live artifacts, git objects/refs, runtime records, state/message/store records, exact evaluator returns, authoritative application records, or other execution-proximate sources. Memory, prior assistant self-report, generated summaries, plans, and self-asserted evidence are testimony only.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"For each material execution-dependent claim identify authority, freshness, execution proximity, specificity, integrity, locator, and exact observed content; compare the claim against that source.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"Every material claim is supported by live authoritative evidence or is explicitly classified as UNKNOWN/PARTIAL/NOT_EXECUTED without being represented as success.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"A claim outruns its evidence, a contradicted/unknown claim is presented as complete, memory/self-report substitutes for a live source, or a live source is available but not checked.\"","eol":"\n"},{"type":"content","text":"    },","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"      \"key\": \"ground_truth_status\",","eol":"\n"},{"type":"content","text":"      \"value\": \"VERIFIED|CONTRADICTED|PARTIAL|UNKNOWN|NOT_EXECUTED\",","eol":"\n"},{"type":"content","text":"      \"definition\": \"VERIFIED means direct authoritative support; CONTRADICTED means direct conflict; PARTIAL means only part of the claim is supported; UNKNOWN means the authoritative source is unavailable/ambiguous/unresolved; NOT_EXECUTED means live evidence establishes the claimed action did not occur.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"Assign exactly one status from live evidence and preserve modifiers/exceptions rather than collapsing qualified claims.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"Status matches the evidence and scope of the complete claim.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"UNKNOWN/PARTIAL/NOT_EXECUTED is converted into success or a contradiction is ignored.\"","eol":"\n"},{"type":"content","text":"    },","eol":"\n"},{"type":"content","text":"    \"exact_satisfaction\": {","eol":"\n"},{"type":"content","text":"      \"key\": \"exact_satisfaction\",","eol":"\n"},{"type":"content","text":"      \"value\": \"P satisfies U only when every requirement and modifier is met without unauthorized extra work.\",","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"      \"definition_of_evaluation\": \"Compare P independently against each decomposed requirement and modifier.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"Every requirement passes and no unauthorized action is introduced.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"Any required result is missing, prohibition violated, modifier changed, target changed, or extra work introduced.\"","eol":"\n"},{"type":"content","text":"    }","eol":"\n"},{"type":"content","text":"  }","eol":"\n"},{"type":"content","text":"}","eol":"\n"},{"type":"content","text":"```","eol":"\n"},{"type":"content","text":"","eol":"\n"},{"type":"content","text":"## Governing Rule Catalog","eol":"\n"},{"type":"content","text":"","eol":"\n"},{"type":"content","text":"```json","eol":"\n"},{"type":"content","text":"{","eol":"\n"},{"type":"content","text":"  \"rules\": {","eol":"\n"},{"type":"content","text":"    \"shared_configuration_contract_governs_external_references\": {","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"      \"value\": \"All external file dependencies, triggers, runtime roots, and evaluation artifacts are declared in ChatMachines/GeminiSupervisor/config.json. Specification and runtime refer to named keys in that shared config rather than independently hardcoding external paths.\",","eol":"\n"},{"type":"content","text":"      \"definition\": \"External file locations must remain identical between specification and runtime via one shared supervisor configuration.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"Compare external path references in Agents.md and send-to-gemini.js against the entries in ChatMachines/GeminiSupervisor/config.json.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"Both specification and runtime resolve external dependencies from config.json using matching keys.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"An external file path is hardcoded divergently or bypasses the shared configuration keys.\",","eol":"\n"},{"type":"content","text":"      \"scenario_examples\": {","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"          {\"scenario\":\"Runtime reads triggerPath from config.json key trigger_file.\",\"criterion_used\":\"config resolution\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Agents.md instructs supervisor to consult the artifact defined under step3_evaluation_artifact in config.json.\",\"criterion_used\":\"named key reference\",\"status\":\"PASS\"}","eol":"\n"},{"type":"content","text":"        ],","eol":"\n"},{"type":"content","text":"        \"rule_breaking\": [","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Runtime hardcodes an external test file path that differs from the path in config.json.\",\"criterion_used\":\"divergent path\",\"status\":\"FAIL\"},","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"          {\"scenario\":\"Specification and runtime invent different keys for the same file artifact.\",\"criterion_used\":\"key mismatch\",\"status\":\"FAIL\"}","eol":"\n"},{"type":"content","text":"        ]","eol":"\n"},{"type":"content","text":"      }","eol":"\n"},{"type":"content","text":"    },","eol":"\n"},{"type":"content","text":"    \"return_schema_is_the_exclusive_per_step_execution_and_completion_control_surface\": {","eol":"\n"},{"type":"content","text":"      \"key\": \"return_schema_is_the_exclusive_per_step_execution_and_completion_control_surface\",","eol":"\n"},{"type":"content","text":"      \"value\": \"Every step has a required return schema; the ChatGPT-owned execution result is persisted and Gemini evaluates that exact schema before advancement. A failed earlier gate cannot be bypassed. return_schema_completed refers only to the current step.\",","eol":"\n"},{"type":"content","text":"      \"definition\": \"Per-step return schemas are the canonical execution and gating interface.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"Check schema shape, required fields, truthfulness, persistence, role ownership, completion semantics, and current-step gate state.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"The current-step schema is complete, truthful, persisted, produced by the required role, and advances only after PASS.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"A schema/control requirement is absent/false, a failed step is bypassed, or step completion is misrepresented as whole-procedure completion.\",","eol":"\n"},{"type":"content","text":"      \"scenario_examples\": {","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"          {\"scenario\":\"Step 2 is persisted and receives Gemini PASS before Step 3.\",\"criterion_used\":\"gate order\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Step 3 marks return_schema_completed only after A-G and tests are complete.\",\"criterion_used\":\"per-step completion\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"A Step 2 FAIL remains at Step 2 for correction.\",\"criterion_used\":\"failed gate cannot be bypassed\",\"status\":\"PASS\"}","eol":"\n"},{"type":"content","text":"        ],","eol":"\n"},{"type":"content","text":"        \"rule_breaking\": [","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Step 1 omits a required field but the controller advances.\",\"criterion_used\":\"schema completeness\",\"status\":\"FAIL\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"A Step 3 FAIL is followed by Step 4 execution.\",\"criterion_used\":\"failed gate cannot be bypassed\",\"status\":\"FAIL\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"return_schema_completed=true is reported as proof that all steps are done.\",\"criterion_used\":\"per-step completion\",\"status\":\"FAIL\"}","eol":"\n"},{"type":"content","text":"        ]","eol":"\n"},{"type":"content","text":"      }","eol":"\n"},{"type":"content","text":"    },","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"      \"key\": \"model_role_separation_and_server_verified_execution_identity_are_mandatory\",","eol":"\n"},{"type":"content","text":"      \"value\": \"Steps 0-4 are ChatGPT-owned. Supervisory gates are Gemini-owned. Neither role may execute, repair, retry, or simulate the other role's work. role_completed must be supported by runtime/server evidence.\",","eol":"\n"},{"type":"content","text":"      \"definition\": \"Role ownership is a runtime boundary, not a textual label.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"Compare role_required, role_forbidden, role_completed, and role_verification to observed execution locus.\",","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"      \"fail_criteria\": \"Wrong role executed, evidence is missing/conflicting, or output is relabeled to hide origin.\",","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"        \"rule_following\": [","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"ChatGPT authors the execution return through the connected GitHub tool.\",\"criterion_used\":\"ChatGPT-owned execution\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Gemini API produces the supervisory gate inside send-to-gemini.js.\",\"criterion_used\":\"Gemini-owned gate\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"A Gemini-authored Step 2 payload is rejected despite valid JSON.\",\"criterion_used\":\"no role laundering\",\"status\":\"PASS\"}","eol":"\n"},{"type":"content","text":"        ],","eol":"\n"},{"type":"content","text":"        \"rule_breaking\": [","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Gemini is asked to generate Step 3 execution content.\",\"criterion_used\":\"forbidden execution role\",\"status\":\"FAIL\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"ChatGPT fabricates a Gemini PASS.\",\"criterion_used\":\"no simulation\",\"status\":\"FAIL\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"A payload self-labels as ChatGPT while runtime provenance shows Gemini.\",\"criterion_used\":\"runtime evidence controls\",\"status\":\"FAIL\"}","eol":"\n"},{"type":"content","text":"        ]","eol":"\n"},{"type":"content","text":"      }","eol":"\n"},{"type":"content","text":"    },","eol":"\n"},{"type":"content","text":"    \"chatgpt_turn_must_span_every_nonterminal_nextmessage_to_gemini_response_handshake\": {","eol":"\n"},{"type":"content","text":"      \"key\": \"chatgpt_turn_must_span_every_nonterminal_nextmessage_to_gemini_response_handshake\",","eol":"\n"},{"type":"content","text":"      \"value\": \"A nextmessage commit creates a mandatory wait for the corresponding Gemini response. On FAIL ChatGPT corrects the same step and recommits. On PASS with remaining work ChatGPT executes the next step. The turn ends only after the latest response and terminal state.\",","eol":"\n"},{"type":"content","text":"      \"definition\": \"The user-facing turn spans the complete commit-response-control loop.\",","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"      \"pass_criteria\": \"No outstanding response exists and either continuation occurs or the procedure is terminal.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"The turn ends after a commit, nonterminal PASS, or FAIL without same-step correction.\",","eol":"\n"},{"type":"content","text":"      \"scenario_examples\": {","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"          {\"scenario\":\"Step 1 PASS immediately continues to Step 2.\",\"criterion_used\":\"nonterminal continuation\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Step 3 FAIL is corrected in the same run.\",\"criterion_used\":\"same-step retry\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Step 4 PASS with no remaining steps ends the turn.\",\"criterion_used\":\"terminal condition\",\"status\":\"PASS\"}","eol":"\n"},{"type":"content","text":"        ],","eol":"\n"},{"type":"content","text":"        \"rule_breaking\": [","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"ChatGPT says committed and ends before Gemini responds.\",\"criterion_used\":\"outstanding response\",\"status\":\"FAIL\"},","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"          {\"scenario\":\"A FAIL is merely reported to the user.\",\"criterion_used\":\"same-step retry\",\"status\":\"FAIL\"}","eol":"\n"},{"type":"content","text":"        ]","eol":"\n"},{"type":"content","text":"      }","eol":"\n"},{"type":"content","text":"    },","eol":"\n"},{"type":"content","text":"    \"bootstrap_must_create_and_isolate_a_consistent_run_container_before_step_zero\": {","eol":"\n"},{"type":"content","text":"      \"key\": \"bootstrap_must_create_and_isolate_a_consistent_run_container_before_step_zero\",","eol":"\n"},{"type":"content","text":"      \"value\": \"Each run has path-safe run_nonce and isolated state.json, messages.json, and store/store.json under runs/<run_nonce>/. Execution and gate records remain in that run.\",","eol":"\n"},{"type":"content","text":"      \"definition\": \"Bootstrap establishes run identity, persistence, and isolation.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"Verify the three live files, matching nonce values, isolation, initial request persistence, and bootstrap-before-Step-0 order.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"All run-container invariants hold and only the active run is mutated.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"Files are absent, nonce mismatches, another run is mutated, or Step 0 occurs before bootstrap.\",","eol":"\n"},{"type":"content","text":"      \"scenario_examples\": {","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"          {\"scenario\":\"All three run files exist with the same nonce.\",\"criterion_used\":\"container consistency\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Retry records remain under the same nonce.\",\"criterion_used\":\"run isolation\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Initial user text is persisted before Step 0 completes.\",\"criterion_used\":\"initial persistence\",\"status\":\"PASS\"}","eol":"\n"},{"type":"content","text":"        ],","eol":"\n"},{"type":"content","text":"        \"rule_breaking\": [","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"messages.json has another nonce.\",\"criterion_used\":\"nonce consistency\",\"status\":\"FAIL\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Step 0 writes into another run directory.\",\"criterion_used\":\"isolation\",\"status\":\"FAIL\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"A required run file is missing.\",\"criterion_used\":\"container completeness\",\"status\":\"FAIL\"}","eol":"\n"},{"type":"content","text":"        ]","eol":"\n"},{"type":"content","text":"      }","eol":"\n"},{"type":"content","text":"    },","eol":"\n"},{"type":"content","text":"    \"live_ground_truth_verification_against_pathological_deception\": {","eol":"\n"},{"type":"content","text":"      \"key\": \"live_ground_truth_verification_against_pathological_deception\",","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"      \"definition\": \"Live ground-truth verification prevents fabricated paths, commits, artifacts, evaluator results, execution status, and completion claims from passing because their JSON is syntactically plausible. Ground truth includes current artifact bytes/text, git blobs/commits/refs, runtime/tool records, state/messages/store records, exact evaluator returns, and other authoritative execution-proximate sources.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"Extract material execution-dependent claims; map each to an authoritative live source; retrieve/inspect that source; preserve source and locator plus exact observed content; evaluate authority, freshness, execution proximity, specificity, and integrity; assign VERIFIED, CONTRADICTED, PARTIAL, UNKNOWN, or NOT_EXECUTED; resolve conflicts by authority/freshness; never convert UNKNOWN/PARTIAL/NOT_EXECUTED into success.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"Every material completion/execution/artifact claim either has VERIFIED live evidence or is accurately reported as non-verified without implying success. No blocking live-ground-truth finding is ignored by a PASS gate.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"A material claim is accepted from self-report, memory, stale summary, or unverified locator; a live source contradicts the claim; required live evidence is unavailable but success is asserted; a blocking finding is omitted or ignored; or Gemini alters deterministic findings supplied by the runtime.\",","eol":"\n"},{"type":"content","text":"      \"scenario_examples\": {","eol":"\n"},{"type":"content","text":"        \"rule_following\": [","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"A claimed commit SHA is checked in the live git object database and exists before the completion claim passes.\",\"criterion_used\":\"authoritative source-control verification\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Step 4 names a file and content; the runtime reads the live workspace file and confirms the claimed text before Gemini passes it.\",\"criterion_used\":\"artifact existence/content verification\",\"status\":\"PASS\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"The runtime cannot verify a claimed external send, marks it UNKNOWN, and the gate refuses to treat it as completed.\",\"criterion_used\":\"UNKNOWN is not success\",\"status\":\"PASS\"}","eol":"\n"},{"type":"content","text":"        ],","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"          {\"scenario\":\"The agent says 'I committed it' and Gemini passes solely because completion_evidence contains that sentence.\",\"criterion_used\":\"self-report is testimony\",\"status\":\"FAIL\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"A file locator does not exist in the live workspace but the gate returns PASS.\",\"criterion_used\":\"contradicted artifact claim\",\"status\":\"FAIL\"},","eol":"\n"},{"type":"content","text":"          {\"scenario\":\"Gemini rewrites a deterministic finding from CONTRADICTED to VERIFIED.\",\"criterion_used\":\"deterministic findings are immutable evidence\",\"status\":\"FAIL\"}","eol":"\n"},{"type":"content","text":"        ]","eol":"\n"},{"type":"content","text":"      }","eol":"\n"},{"type":"content","text":"    },","eol":"\n"},{"type":"content","text":"    \"step_four_reporting_must_put_failures_and_incomplete_work_before_verified_completion\": {","eol":"\n"},{"^MISSING_KEY^":"^MISSING_VALUE^"},{"type":"content","text":"      \"value\": \"Step 4 reports failed actions first, incomplete actions second, and only verified completed actions last; every completion requires granular evidence.\",","eol":"\n"},{"type":"content","text":"      \"definition\": \"Final reporting order prevents partial work from being hidden behind completion language.\",","eol":"\n"},{"type":"content","text":"      \"definition_of_evaluation\": \"Compare actual plan/requirements and live evidence to failed_actions, not_completed_actions, and completed_actions.\",","eol":"\n"},{"type":"content","text":"      \"pass_criteria\": \"Every failure/incomplete item is represented first and every completion is live-ground-truth VERIFIED.\",","eol":"\n"},{"type":"content","text":"      \"fail_criteria\": \"A failure/incomplete item is omitted or a completion lacks verified evidence.\"","eol":"\n"},{"type":"content","text":"    }","eol":"\n"},{"type":"content","text":"  }","eol":"\n"},{"type":"content","text":"}","eol":"\n"},{"type":"content","text":"```","eol":"\n"},{"type":"content","text":"","eol":"\n"},{"type":"content","text":"## Procedure Dependency Chart","eol":"\n"},{"type":"content","text":"","eol":"\n"},{"type":"content","text":"```json","eol":"\n"},{"type":"content","text":"{","eol":"\n"},{"type":"content","text":"  \"dependency_chart\": [","eol":"\n"},{"type":"content","text":"    {\"source_value\":\"ChatMachines/GeminiSupervisor/config.json\",\"decision\":\"load external file references and runtime path configuration\",\"outputs\":[\"triggerPath\",\"agentsPath\",\"step3EvaluationPath\",\"runsRoot\"],\"source_code_consumer\":\"loadSupervisorConfig\"},","eol":"\n"},{"type":"content","text":"    {\"source_value\":\"nextmessage.run_nonce\",\"decision\":\"select or create isolated run container\",\"outputs\":[\"runs/<run_nonce>/state.json\",\"runs/<run_nonce>/messages.json\",\"runs/<run_nonce>/store/store.json\"],\"source_code_consumer\":\"initRun\"},","eol":"\n"},{"type":"content","text":"    {\"source_value\":\"execution.step\",\"decision\":\"must equal current_state.procedure.current_step\",\"outputs\":[\"deterministic_validation_failures\"],\"source_
{
  "definitions": {
    "inputValues": "Every state property except render."
  },
  "transitions": [
    {
      "on": "initialize",
      "render": null,
      "actions": [
        {
          "set": {
            "inputValues": null
          }
        },
        {
          "set": {
            "render": 1
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 1,
      "actions": [
        {
          "set": {
            "verbatimUserPrompt": "${verbatimUserPrompt}",
            "render": 2
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 2,
      "actions": [
        {
          "set": {
            "userIntent": "${userIntent}",
            "render": 3
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "exampleMatch": "${exampleMatch}",
      "render": 3
    },
    {
      "Boolean": "${exampleMatch}",
      "return": {
        "true": "onTrue",
        "false": "continue"
      }
    },
    {
      "onTrue": [
        {
          "render": 4
        },
        {
          "userIntent": "${userIntent}",
          "render": 5
        },
        {
          "render": 6
        },
        {
          "minimalResult": "${minimalResult}",
          "render": 7
        }
      ]
    },
    {
      "render": 8,
      "actions": [
        {
          "set": {
            "targetFiles": "${targetFiles}",
            "render": 9
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 9,
      "actions": [
        {
          "set": {
            "requirements": "${requirements}",
            "render": 10
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 10,
      "actions": [
        {
          "set": {
            "userIntent": "${userIntent}",
            "render": 11
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 11,
      "actions": [
        {
          "set": {
            "matchedExample": "${matchedExample}",
            "render": 12
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "mode": "${mode}",
      "render": 12
    },
    {
      "Boolean": "${mode} = \"fidelity\"",
      "return": {
        "true": "onTrue",
        "false": "continue"
      }
    },
    {
      "onTrue": [
        {
          "render": 14
        },
        {
          "requirements": "${requirements}",
          "render": 15
        },
        {
          "render": 16
        },
        {
          "changeList": "${changeList}",
          "render": 17
        }
      ]
    },
    {
      "render": 18,
      "next": [
        {
          "if": "${mode} = \"accountability\"",
          "render": 19
        },
        {
          "if": "${mode} != \"accountability\"",
          "render": null
        }
      ]
    },
    {
      "render": 19,
      "actions": [
        {
          "set": {
            "requirementsCompleted": "${requirementsCompleted}",
            "render": 20
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 20,
      "actions": [
        {
          "set": {
            "requirements": "${requirements}",
            "render": 21
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 21,
      "actions": [
        {
          "set": {
            "render": 22
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 22,
      "actions": [
        {
          "set": {
            "changeList": "${changeList}",
            "render": 23
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 23,
      "actions": [
        {
          "set": {
            "changeAssessment": "${changeAssessment}",
            "render": 24
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 24,
      "actions": [
        {
          "set": {
            "completionAssessment": "${completionAssessment}",
            "render": 25
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 25,
      "actions": [
        {
          "set": {
            "requirementsCompleted": "${requirementsCompleted}",
            "render": 26
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 26,
      "actions": [
        {
          "set": {
            "rescissionRequirements": "${rescissionRequirements}",
            "render": 27
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 27,
      "actions": [
        {
          "set": {
            "requirements": "${requirements}",
            "render": 28
          }
        },
        {
          "call": {
            "renderer": "render-instructions.js",
            "argument": "state"
          }
        }
      ]
    },
    {
      "render": 28,
      "next": [
        {
          "if": "${requirements}.length = 0",
          "render": null
        },
        {
          "if": "${requirements}.length > 0",
          "render": 21
        }
      ]
    }
  ]
}

{
  "transitions": [
    {
      "render": 1,
      "verbatimUserPrompt": null,
      "userIntent": null,
      "exampleMatch": null,
      "minimalResult": null,
      "targetFiles": null,
      "requirements": null,
      "matchedExample": null,
      "mode": null,
      "changeList": null,
      "requirementsCompleted": null,
      "changeAssessment": null,
      "completionAssessment": null,
      "rescissionRequirements": null,
      "loopNumber": null
    },
    {
      "verbatimUserPrompt": "${verbatimUserPrompt}",
      "render": 2
    },
    {
      "userIntent": "${userIntent}",
      "render": 3
    },
    {
      "exampleMatch": "${exampleMatch}"
    },
    {
      "Boolean": "${exampleMatch}",
      "return": {
        "true": "onTrue",
        "false": "continue"
      }
    },
    {
      "onTrue": [
        {
          "render": 4
        },
        {
          "userIntent": "${userIntent}",
          "render": 5
        },
        {
          "render": 6
        },
        {
          "minimalResult": "${minimalResult}",
          "render": 7
        }
      ]
    },
    {
      "render": 8
    },
    {
      "targetFiles": "${targetFiles}",
      "render": 9
    },
    {
      "requirements": "${requirements}",
      "render": 10
    },
    {
      "userIntent": "${userIntent}",
      "render": 11
    },
    {
      "matchedExample": "${matchedExample}"
    },
    {
      "call": {
        "function": "lookupMode",
        "arguments": [
          "${matchedExample}",
          "${lookupTable}"
        ],
        "return": "${mode}"
      }
    },
    {
      "Boolean": "${mode} = \"fidelity\"",
      "return": {
        "true": "onTrue",
        "false": "continue"
      }
    },
    {
      "onTrue": [
        {
          "render": 14
        },
        {
          "requirements": "${requirements}",
          "render": 15
        },
        {
          "render": 16
        },
        {
          "changeList": "${changeList}",
          "render": 17
        }
      ]
    },
    {
      "requirementsCompleted": [],
      "render": 19
    },
    {
      "requirements": "${requirements}",
      "render": 20
    },
    {
      "loopNumber": 0
    },
    {
      "entry": "RequirementsLoop",
      "loopNumber": "${loopNumber} + 1"
    },
    {
      "render": 21
    },
    {
      "changeList": "${changeList}",
      "render": 22
    },
    {
      "changeAssessment": "${changeAssessment}",
      "render": 23
    },
    {
      "completionAssessment": "${completionAssessment}",
      "render": 24
    },
    {
      "requirementsCompleted": "${requirementsCompleted}",
      "render": 25
    },
    {
      "rescissionRequirements": "${rescissionRequirements}",
      "render": 26
    },
    {
      "requirements": "${requirements}",
      "render": 27
    },
    {
      "Boolean": "${requirements}.length = 0",
      "return": {
        "true": "onTrue",
        "false": {
          "pointer": "RequirementsLoop"
        }
      }
    },
    {
      "onTrue": []
    }
  ],
  "lookupTable": {
    "1": "fidelity",
    "2": "accountability",
    "3": "accountability",
    "4": "fidelity",
    "5": "accountability",
    "6": "fidelity",
    "7": "accountability",
    "8": "accountability",
    "9": "fidelity"
  }
}

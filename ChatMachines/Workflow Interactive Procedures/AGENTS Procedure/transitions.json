        {
          "userIntent": "${userIntent}",
          "render": 5
        },
        {
          "render": 6
        },
        {
          "minimalResult": "${minimalResult}",
          "render": 7
        }
      ]
    },
    {
      "render": 8
    },
    {
      "targetFiles": "${targetFiles}",
      "render": 9
    },
    {
      "requirements": "${requirements}",
      "render": 10
    },
    {
      "userIntent": "${userIntent}",
      "render": 11
    },
    {
      "matchedExample": "${matchedExample}"
    },
    {
      "call": {
        "function": "lookupMode",
        "arguments": [
          "${matchedExample}",
          "${lookupTable}"
        ],
        "return": "${mode}"
      },
      "Boolean": "${mode} = \"fidelity\"",
      "return": {
        "true": "onTrue",
        "false": "continue"
      }
    },
    {
      "onTrue": [
        {
          "requirements": "${requirements}",
          "render": 12,
